// === DEFAULT WINDOW APPEARANCE ===
window-rule {
  tiled-state true
  geometry-corner-radius 10
  clip-to-geometry true
  draw-border-with-background false
}

// === DEFAULT WINDOW SCREENCAST ===
window-rule {
  match is-window-cast-target=true

  focus-ring {
    width 0
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
  }

  border {
    on
    width 2
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
  }

  tab-indicator {
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
  }
}

// === NOCTALIA ===
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true

  default-column-width {
    fixed 1080
  }

  default-window-height {
    fixed 920
  }

  background-effect {
    xray false
  }
}

// === FLOATING APPLICATIONS ===
window-rule {
  match app-id=r#"firefox$"# title="^Picture-in-Picture$"
  open-floating true
  default-floating-position x=10 y=10 relative-to="top-right"
  default-column-width { fixed 480; }
  default-window-height { fixed 270; }
}

// === GNOME APPLICATIONS ===
window-rule {
  match app-id="org.gnome.Calculator"
  open-floating true
}

window-rule {
  match app-id="org.gnome.Nautilus" title="Open File|Open Folder"
  open-floating true
}

window-rule {
  match app-id="org.gnome.Loupe|org.gnome.Showtime"
  open-floating true
  default-column-width { fixed 890; }
  default-window-height { fixed 550; }
}

// === TERMINAL ===
window-rule {
  match app-id="Alacritty"
  opacity 0.85
  draw-border-with-background false
  background-effect {
    blur true
  }
}

// === APPLICATIONS ===
window-rule {
  match app-id=r#"code$"#
  open-maximized true
}
